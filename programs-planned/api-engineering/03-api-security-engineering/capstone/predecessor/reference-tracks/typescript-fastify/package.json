{
  "name": "analysis-service-typescript",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/ && npm run core:test",
    "core:build": "tsc -p tsconfig.core.json",
    "core:test": "npm run core:build && node --test test-core/*.test.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.2",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.7",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "tsx": "4.23.5",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bijux.dev/events/event-envelope/v1",
  "title": "Bijux event envelope profile 1.0",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "tenantid",
    "correlationid",
    "causationid",
    "partitionkey",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "tenantid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationid": {
      "type": "string",
      "format": "uuid"
    },
    "causationid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "partitionkey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bijux.dev/events/artifact-published.v1",
  "title": "Analysis artifact published data",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "artifactId",
    "runId",
    "mediaType",
    "sizeBytes",
    "sha256",
    "publishedAt"
  ],
  "additionalProperties": false
}

# syntax=docker.io/docker/dockerfile-upstream:1.26.0
ARG GO_BASE=golang:1.26.0-bookworm
FROM --platform=$BUILDPLATFORM ${GO_BASE} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod ./
COPY cmd/atlas-api ./cmd/atlas-api
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags='-s -w -buildid=' -o /out/atlas-api ./cmd/atlas-api

FROM scratch
COPY --from=build /out/atlas-api /usr/local/bin/atlas-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/atlas-api"]

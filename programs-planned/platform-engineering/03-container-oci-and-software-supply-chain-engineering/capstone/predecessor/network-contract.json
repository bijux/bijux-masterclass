{
  "ingress": [
    {
      "name": "api",
      "protocol": "HTTP",
      "port": 8080,
      "source": "governed-edge-security-identity"
    }
  ],
  "egress": [
    {
      "name": "configuration",
      "destination": "approved-parameter-secret-endpoints"

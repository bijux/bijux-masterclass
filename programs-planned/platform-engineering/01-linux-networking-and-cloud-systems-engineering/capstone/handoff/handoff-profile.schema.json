{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.bijux.dev/schemas/course-01-to-02-handoff-1.0.schema.json",
  "title": "Platform Engineering Course 1 to Course 2 Requirements",
  "type": "object",
  "required": [
    "profileVersion",
    "targetCourse",
    "requirements"
  ],
  "properties": {
    "profileVersion": {
      "const": "1.0"
    },
    "targetCourse": {
      "const": "02-infrastructure-as-code-and-cloud-foundation-engineering"
    },
    "requirements": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "statement",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PE-CF-[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "acceptance": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

sc_schedules = 0
sc_00 = 0
sc_01 = 0
sc_10 = 0
sc_11 = 0
buffered_schedules = 0
buffered_00 = 0
buffered_01 = 0
buffered_10 = 0
buffered_11 = 0

def classify(r0, r1, buffered):
    global sc_00, sc_01, sc_10, sc_11
    global buffered_00, buffered_01, buffered_10, buffered_11
    if buffered:
        if r0 == 0 and r1 == 0:
            buffered_00 += 1
        elif r0 == 0:
            buffered_01 += 1
        elif r1 == 0:
            buffered_10 += 1
        else:

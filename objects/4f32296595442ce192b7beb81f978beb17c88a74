    else:
        if r0 == 0 and r1 == 0:
            sc_00 += 1
        elif r0 == 0:
            sc_01 += 1
        elif r1 == 0:
            sc_10 += 1
        else:
            sc_11 += 1

def evaluate(order, buffered):
    global sc_schedules, buffered_schedules
    x = 0
    y = 0
    r0 = -1
    r1 = -1
    seen_s0 = False
    seen_s1 = False
    valid = True
    for event in order:
        if event == "S0":
            seen_s0 = True
            if not buffered:
                x = 1
        elif event == "S1":
            seen_s1 = True
            if not buffered:
                y = 1
        elif event == "L0":
            if not seen_s0:
                valid = False
            r0 = y
        elif event == "L1":
            if not seen_s1:
                valid = False
            r1 = x
        elif event == "F0":
            if not seen_s0:
                valid = False
            x = 1
        elif event == "F1":
            if not seen_s1:
                valid = False
            y = 1
